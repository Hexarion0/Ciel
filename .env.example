# Environment & Logging
CIEL_ENV=development
CIEL_LOG_LEVEL=INFO
# Setup asks what CIEL should call you. Empty uses your computer username.
CIEL_PREFERRED_NAME=
# Optional UTF-8 style preferences, reloaded before each AI reply. Empty disables.
# Setup can save an accepted AI interview draft here, preserving your own text.
CIEL_PERSONA_FILE=persona.txt

# Memory: automatic saves supported clear first-person statements; confirm asks first;
# explicit only saves remember commands. General conversation is not extracted into facts.
# Setup asks which learning preference to use; the default is confirm.
MEMORY_DB_PATH=data/ciel.db
# Durable memory is editable Markdown; the default root is data/ciel.workspace.
# Leave this blank to derive an isolated .workspace directory from MEMORY_DB_PATH.
MEMORY_WORKSPACE_ENABLED=true
MEMORY_WORKSPACE_PATH=
MEMORY_WORKSPACE_BOOTSTRAP_MAX_CHARS=8000
MEMORY_DAILY_CAPTURE_ENABLED=true
MEMORY_FLUSH_ENABLED=true
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_TIME=03:00
MEMORY_SEARCH_MAX_RESULTS=6
MEMORY_SEARCH_MIN_SCORE=0.35
MEMORY_LEARNING_MODE=confirm
# Confirm conflicting replacements, including explicit remember commands.
MEMORY_CONFIRM_CORRECTIONS=true
MEMORY_RECALL_ENABLED=true
MEMORY_MAX_SHORT_TERM_TURNS=10
# Ranked query matches plus bounded profile/project continuity anchors.
MEMORY_RECALL_LIMIT=4
MEMORY_RECALL_MAX_CHARS=6000
# Total replayed summary/dialogue characters; the system prompt has a separate budget.
MEMORY_MAX_CONTEXT_CHARS=24000
# Optional local CPU embeddings; keep disabled until semantic-evaluate records an improvement.
# Select a locally installed Ollama embedding model. No model is downloaded automatically.
MEMORY_SEMANTIC_ENABLED=false
MEMORY_SEMANTIC_MODEL=
MEMORY_SEMANTIC_HOST=http://127.0.0.1:11434
MEMORY_SEMANTIC_TIMEOUT_SECONDS=1.5

# AI Providers
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_COMPLEX_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Use Ultra if the requested Super endpoint is unavailable; report the model that served the reply.
NIM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# auto: normal replies off, complex work on; /reasoning auto|on|off changes this session.
NIM_REASONING=auto
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# On-request screen awareness uses only this selected existing AI connection.
# Configure the connection and an image-capable model in setup. No text-model fallback.
# A synthetic image test must pass before any personal screenshot is sent.
SCREEN_ENABLED=true
SCREEN_PROVIDER=nim
SCREEN_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Per-request bound, including synthetic verification requests (1-120 seconds).
SCREEN_TIMEOUT_SECONDS=60

# Optional messaging channels. Select services in `ciel chat setup` (Telegram first).
# Selected services start automatically now and at login on Linux. Pair Telegram once.
CHAT_SERVICES=
# Create a bot with Telegram's @BotFather; keep its token private.
TELEGRAM_BOT_TOKEN=
# Pairing, delivery receipts, and poll offsets; separate from conversation memory.
CHAT_STATE_PATH=data/chat.db
# This PC must be on, signed in, and connected. No manual chat start is needed.

# Main response model answers or selects native tools in the same request.
# Keep enabled for the unified flow; false retains the legacy desktop intent path.
# CONTROLLER_MODEL remains for legacy diagnostics and progress utilities only.
CONTROLLER_ENABLED=true
CONTROLLER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Web relevance check budget (0.1-30s); main model rounds clamped to 3-5.
CONTROLLER_TIMEOUT_SECONDS=8.0
CONTROLLER_MAX_TOOL_STEPS=3

# Public web search and page reading (free by default)
# false disables retrieval, including explicit searches and public links.
INTERNET_ENABLED=true
# Parallel's free search needs no account or API key and has lower usage limits.
# Other explicit choices: ddgs (DuckDuckGo/public Brave, no key), brave, or tavily.
# Only this provider is used; other saved keys never enable automatic fallback.
INTERNET_PROVIDER=parallel
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Search current facts without a command; false keeps explicit searches/links.
INTERNET_AUTOMATIC=true
# Optional city and country (up to 200 characters); explicit locations take priority.
# Setup asks for this location. Leave empty to ask when needed; timezone is not a city.
INTERNET_HOME_CITY=
# Individual lookup budgets in seconds; ranges 0.1-60 and 0.1-120 respectively.
INTERNET_TIMEOUT_SECONDS=8.0
INTERNET_RESEARCH_TIMEOUT_SECONDS=20.0
# Result limits: 1-10 for quick answers, 1-20 for research/compare/double-check.
INTERNET_MAX_RESULTS=5
INTERNET_RESEARCH_MAX_RESULTS=8
# Page limits: 0-5 and 0-10; zero keeps search snippets without page reads.
INTERNET_MAX_PAGES=2
INTERNET_RESEARCH_MAX_PAGES=4

# Audio & Voice Settings
WAKE_WORD=hey ciel
# Optional openWakeWord model paths/names as a JSON list. Empty uses Whisper only.
WAKE_MODELS=[]
# After train-wake: WAKE_MODELS=["models/custom/hey_ciel.onnx"]
# Quiet-voice sensitivity (raise to reduce noise checks); retains slower greetings.
WAKE_MIN_RMS=0.006
WAKE_WINDOW_SECONDS=3.0
# Continuous transcription is the normal launch mode; background excerpts stay temporary.
AMBIENT_LISTENING=true
AMBIENT_FOLLOWUP_SECONDS=300
# conversation keeps recent dialogue engaged; strict requires high gate confidence.
AMBIENT_FOLLOWUP_POLICY=conversation
# Includes rejected background transcripts in local logs; set false for normal use.
SHOW_TRANSCRIPTS=false
# Reveal AI caption letters during voice playback; separate from raw STT logs.
SHOW_AI_TRANSCRIPTS=true
# Headphones: speech interrupts playback without waiting for a wake word.
# Speakers: use wake to reduce interruptions caused by hearing CIEL herself.
BARGE_IN_MODE=speech
BARGE_IN_SPEECH_SECONDS=0.24
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
STT_MODEL=small.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
# Maximum wait for command transcription's model startup.
STT_STARTUP_TIMEOUT_SECONDS=120
# Pocket runs on CPU; install .[pocket-tts]. See docs/pocket-tts.md.
# Custom references require access to Kyutai's voice-cloning model.
# Without a neutral reference Pocket uses provisional Alba, consistently for all styles.
TTS_ENGINE=pocket
TTS_VOICE=ciel
TTS_POCKET_DEVICE=cpu
TTS_POCKET_QUANTIZATION=none
TTS_POCKET_STREAMING=true
# Pocket-only static output gain: -60 to 0 dB; 0 keeps the original level.
TTS_POCKET_GAIN_DB=0
TTS_POCKET_REFERENCES=data/voices/ciel
# Optional existing same-speaker neutral recording (absolute or repo-relative path).
# TTS_POCKET_NEUTRAL_REFERENCE=data/voice/references/ciel/reference-1.wav
TTS_POCKET_LANGUAGE=english_2026-09
TTS_POCKET_BUILTIN_VOICE=alba
# Final fallback must be installed locally. HQ: TTS_ENGINE=chatterbox_turbo or hq.
TTS_FALLBACK_VOICE=en_US-ciel-medium
TTS_VOICE_PROFILES=voice_profiles
TTS_CHATTERBOX_MODEL=data/voice/models/chatterbox-turbo
TTS_CHATTERBOX_PYTHON=data/voice/envs/clone/bin/python
TTS_MIN_FREE_VRAM_MB=3000
TTS_AUDIO_QUEUE_SIZE=2
# Turbo vocal cues: expressive (up to 2/reply), natural (1), or off (0).
# Controls cue frequency, not a sustained mood or acoustic emotion intensity.
TTS_EXPRESSIVENESS=expressive
# An unresponsive Turbo worker falls back to local Piper after this deadline.
TTS_SYNTHESIS_TIMEOUT_SECONDS=60
# Output buffer in seconds; increase to 0.20 if speech stutters under CPU load.
TTS_PLAYBACK_LATENCY=0.12
TTS_SPEED=1.0
TTS_ENABLED=true
# Speak completed sentences as the AI generates them; false restores batch replies.
TTS_STREAMING=true

# Listening latency: raise these if you prefer more decoding or longer pauses
STT_BEAM_SIZE=5
UTTERANCE_SILENCE_SECONDS=0.7
# Extra pause tolerance before ending a turn (total default 0.9s).
UTTERANCE_PAUSE_GRACE_SECONDS=0.2

# Retry unclear utterances with a stronger decoder (loaded only when needed).
# Leave empty to retry only the primary model; medium.en uses more memory.
STT_RETRY_MODEL=medium.en
# Free VRAM required before loading an additional CUDA retry model.
# Below this threshold, retry with the already loaded primary model instead.
STT_RETRY_MIN_FREE_MB=2048
# Diagnostic decoding scores, not calibrated accuracy probabilities.
STT_MIN_CONFIDENCE=0.4
STT_RETRY_CONFIDENCE=0.55
# Whisper wake recognition is independent of command transcription.
WAKE_STT_MODEL=base.en
